# Copy to .env and fill in. With no Firebase values the app runs in local mode
# (everything in the browser's localStorage), which is what the tests use.

# Firebase web app config (Project settings > General > Your apps > SDK setup)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Where the product lives; used in share links and emails.
VITE_PUBLIC_URL=https://practice-slip.web.app

# Support inbox shown in the app and used for invoice requests.
VITE_SUPPORT_EMAIL=hello@example.com

# Admins (comma-separated emails). Must also be listed in firestore.rules.
VITE_ADMIN_EMAILS=liamtw042@gmail.com

# How to pay by bank transfer. Shown on the billing page. Multi-line allowed with \n.
VITE_PAY_INSTRUCTIONS=Bank transfer or PayID to the details on your invoice. Reply to the invoice email with the receipt and your account is switched on the same day.

# Optional hosted checkout links (Lemon Squeezy / Paddle) once a merchant-of-record
# account exists. Leave blank to show invoice-only billing.
VITE_CHECKOUT_URL_MONTHLY=
VITE_CHECKOUT_URL_YEARLY=
