rules_version = '2';

// Practice Slip security rules.
//
// Model: a student document's id IS the parent's capability link. Anyone who
// holds the id can read that one document and tick practice days on it, but
// cannot list documents, change the slip, or touch anything else. Teachers
// own their students. Admins (by email) can activate accounts and read stats.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in ['liamtw042@gmail.com'];
    }

    function ownsStudent() {
      return signedIn() && resource.data.teacherId == request.auth.uid;
    }

    function parentOnlyChanges() {
      // A parent may only tick days, leave a note, and bump updatedAt.
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['log', 'parentNote', 'updatedAt'])
        && request.resource.data.log is map
        && request.resource.data.log.size() <= 400
        && (!('parentNote' in request.resource.data)
            || request.resource.data.parentNote == null
            || (request.resource.data.parentNote.text is string
                && request.resource.data.parentNote.text.size() <= 500));
    }

    match /teachers/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.plan == 'trial';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan', 'planUntil', 'activatedAt', 'trialEndsAt']));
      allow delete: if false;
    }

    match /students/{token} {
      allow get: if true;
      allow list: if ownsStudent() || isAdmin();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid
        && token.size() >= 20;
      allow update: if ownsStudent() || (parentOnlyChanges());
      allow delete: if ownsStudent();

      match /slips/{slipId} {
        allow read, write: if signedIn()
          && get(/databases/$(database)/documents/students/$(token)).data.teacherId == request.auth.uid;
      }
    }

    match /events/{id} {
      allow create: if request.resource.data.type in
        ['signup', 'student_created', 'slip_written', 'slip_shared', 'parent_opened', 'day_ticked', 'parent_note']
        && request.resource.data.at is timestamp;
      allow read: if isAdmin() || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow update, delete: if false;
    }

    match /feedback/{id} {
      allow create: if request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /billingRequests/{id} {
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.teacherId == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
