{
  "name": "practice-slip",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && vite build",
    "ops:snapshot": "node scripts/ops/snapshot.ts",
    "ops:weekly": "node scripts/ops/weekly.ts",
    "ops:mark-sent": "node scripts/ops/mark-sent.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run --dir rules-tests --config rules-tests/vitest.config.ts\""
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "firebase-admin": "^13.0.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase-tools": "^15.19.0"
  }
}
